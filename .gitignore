node_modules/
.DS_Store
# A case folder holds a client's documents. Never commit one: every work/
# folder and every PDF is ignored, wherever it sits. Keep live case folders
# outside this repository altogether.
**/work/
*.pdf
*.PDF
# The worked examples are fiction, generated by their own make-documents.mjs;
# their work/ folders and PDFs (the documents and the rendered complaint) ship.
!examples/**/work/
!examples/**/*.pdf
# Eval workspaces hold model transcripts; they are not part of the package.
dpc-complaint-workspace/
