{
  "name": "dpc-complaint",
  "version": "1.0.0",
  "private": true,
  "description": "A Claude Code skill that drafts an IDEA due process complaint from school documents, with every sentence traced to its source.",
  "type": "module",
  "scripts": {
    "setup": "cd skills/dpc-complaint/scripts && npm install",
    "test": "node --test tests/*.test.mjs",
    "example": "node -e \"const fs=require(\\\"fs\\\"),os=require(\\\"os\\\"),path=require(\\\"path\\\");const d=fs.mkdtempSync(path.join(os.tmpdir(),\\\"dpc-example-\\\"));fs.cpSync(\\\"examples/river-oak\\\",d,{recursive:true});console.log(\\\"running on a copy: \\\"+d);process.exitCode=require(\\\"child_process\\\").spawnSync(process.execPath,[\\\"skills/dpc-complaint/scripts/run-gates.mjs\\\",d],{stdio:\\\"inherit\\\"}).status\""
  },
  "engines": {
    "node": ">=20"
  }
}
